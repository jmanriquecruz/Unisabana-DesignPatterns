          <mxGeometry x="900" y="500" width="340" height="160" as="geometry"/>
        </mxCell>

        <!-- Relations -->

        <!-- Inheritance -->
        <mxCell id="12" style="endArrow=block;endFill=0;" edge="1" parent="1"
          source="3" target="2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="13" style="endArrow=block;endFill=0;" edge="1" parent="1"
