<mxfile host="app.diagrams.net">
  <diagram name="Notification Bridge UML">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Abstraction -->
        <mxCell id="2"
          value="Notification (abstract)&#10;----------------&#10;- platform: INotificationPlatform&#10;- message: string&#10;----------------&#10;+ Send(): void"
          style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="320" height="180" as="geometry"/>
        </mxCell>

        <!-- Refined Abstractions -->
        <mxCell id="3"
          value="MessageNotification&#10;----------------&#10;+ Send(): void"
